digraph flujo { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#F5EFFC", color="#9873BA", fontcolor="#30203D", fontname="Arial", fontsize=12, margin="0.18,0.12", penwidth=1.2]; edge [color="#79569A", fontcolor="#593080", fontname="Arial", fontsize=10, arrowsize=0.7];
i [label="Abrir Usuarios y permisos",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
admin [label="¿Administrador activo\ny sesión vigente?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
no [label="Denegar acceso",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
tipo [label="¿Alta o modificación?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
alta [label="¿Nombre disponible, rol\ny contraseña válidos?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
mod [label="Leer cuenta y versión\nValidar cambios solicitados"];
version [label="¿Versión actual?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
conf [label="Mostrar error y revisar datos\nReabrir si cambió la versión",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
ultimo [label="¿Se dejaría sin\nadministrador activo?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
rech [label="Rechazar el cambio",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
new [label="Guardar cuenta y hash de clave"];
upd [label="Actualizar rol, estado o clave\nIncrementar versión y revocar sesiones"];
audit [label="Registrar historial administrativo\nConfirmar transacción",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
i -> admin;
admin -> no [label="No"];
admin -> tipo [label="Sí"];
tipo -> alta [label="Alta"];
alta -> new [label="Datos válidos"];
alta -> conf [label="Datos inválidos"];
tipo -> mod [label="Modificar"];
mod -> version;
version -> conf [label="No"];
version -> ultimo [label="Sí"];
