digraph flujo { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#F5EFFC", color="#9873BA", fontcolor="#30203D", fontname="Arial", fontsize=12, margin="0.18,0.12", penwidth=1.2]; edge [color="#79569A", fontcolor="#593080", fontname="Arial", fontsize=10, arrowsize=0.7];
i [label="Iniciar sesión como Administrador",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
menu [label="Menú de administración"];
op [label="¿Qué necesita hacer?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
l [label="Crear, editar o archivar lotes"];
p [label="Crear o modificar plantillas\nConfigurar criterios y límites"];
c [label="Crear o continuar controles\nFinalizar o crear revisión"];
u [label="Crear usuarios, cambiar roles\nDesactivar o restablecer contraseña"];
ultimo [label="¿Queda al menos un\nadministrador activo?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
error [label="Rechazar el cambio de usuario",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
api [label="Guardar mediante API\nValidar versión, reglas e historial"];
lectura [label="Consultar lotes, QR, historial\ny resumen de calidad"];
f [label="¿Desea PDF de un\ncontrol finalizado?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
pdf [label="Generar, guardar o compartir PDF",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
fin [label="Continuar consultando\no cerrar sesión",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
i -> menu;
menu -> op;
op -> l [label="Lotes"];
op -> p [label="Plantillas"];
op -> c [label="Controles"];
op -> u [label="Usuarios"];
op -> lectura [label="Consultar"];
l -> api;
p -> api;
c -> api;
u -> ultimo;
ultimo -> error [label="No"];
ultimo -> api [label="Sí"];
api -> fin [label="Guardado correcto"];
lectura -> f;
f -> pdf [label="Sí"];
f -> fin [label="No"];
}
