digraph flujo { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#F5EFFC", color="#9873BA", fontcolor="#30203D", fontname="Arial", fontsize=12, margin="0.18,0.12", penwidth=1.2]; edge [color="#79569A", fontcolor="#593080", fontname="Arial", fontsize=10, arrowsize=0.7];
i [label="Seleccionar control en el historial",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
f [label="¿Está finalizado?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
no [label="No ofrecer reporte\nFinalizar primero si corresponde",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
bot [label="Pulsar Generar reporte PDF"];
leer [label="Descargar datos autenticados"];
ok [label="¿Lectura correcta y existen\nel control y su lote?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
error [label="Mostrar error y botón Reintentar"];
gen [label="Generar PDF en el dispositivo\nResultado, criterios, fechas y QR"];
cache [label="Guardar copia temporal en caché"];
accion [label="¿Qué desea hacer?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
abrir [label="Abrir en lector PDF\nImprimir desde el lector",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
guardar [label="Guardar con selector de archivos",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
comp [label="Compartir con otra aplicación",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
i -> f;
f -> no [label="No"];
f -> bot [label="Sí"];
bot -> leer;
leer -> ok;
ok -> error [label="No"];
error -> leer [label="Reintentar"];
ok -> gen [label="Sí"];
gen -> cache;
gen -> error [label="Error al generar"];
cache -> accion;
accion -> abrir [label="Abrir / imprimir"];
accion -> guardar [label="Guardar"];
accion -> comp [label="Compartir"];
}
