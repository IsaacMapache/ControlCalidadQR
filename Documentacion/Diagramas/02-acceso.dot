digraph flujo { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#F5EFFC", color="#9873BA", fontcolor="#30203D", fontname="Arial", fontsize=12, margin="0.18,0.12", penwidth=1.2]; edge [color="#79569A", fontcolor="#593080", fontname="Arial", fontsize=10, arrowsize=0.7];
i [label="Pantalla de acceso",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
cfg [label="Configurar dirección de API"];
datos [label="Escribir usuario y contraseña"];
vacio [label="¿Ambos campos\ntienen contenido?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
corregir [label="Mostrar aviso y corregir"];
api [label="Enviar solicitud a la API"];
red [label="¿API accesible?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
error [label="Revisar dirección y conexión"];
limite [label="¿Permite más intentos?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
esperar [label="HTTP 429\nEsperar antes de reintentar"];
valida [label="¿Cuenta activa y\ncontraseña correcta?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
fallo [label="HTTP 401\nCorregir credenciales"];
token [label="Crear token aleatorio\nGuardar huella y vencimiento en SQL"];
menu [label="Abrir menú según rol",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
i -> cfg;
cfg -> datos;
datos -> vacio;
vacio -> corregir [label="No"];
corregir -> datos;
vacio -> api [label="Sí"];
api -> red;
red -> error [label="No"];
error -> cfg;
red -> limite [label="Sí"];
limite -> esperar [label="No"];
esperar -> datos;
limite -> valida [label="Sí"];
valida -> fallo [label="No"];
fallo -> datos;
valida -> token [label="Sí"];
token -> menu;
}
