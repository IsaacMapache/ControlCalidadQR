digraph flujo { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#F5EFFC", color="#9873BA", fontcolor="#30203D", fontname="Arial", fontsize=12, margin="0.18,0.12", penwidth=1.2]; edge [color="#79569A", fontcolor="#593080", fontname="Arial", fontsize=10, arrowsize=0.7];
i [label="Iniciar sesión como Inspector",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
menu [label="Menú de trabajo\nSin Usuarios y permisos"];
op [label="¿Qué necesita hacer?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
l [label="Registrar, editar o archivar lotes"];
c [label="Elegir lote y plantilla activos\nCapturar respuestas"];
f [label="¿Guardar borrador\no finalizar?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
b [label="Validar y guardar borrador\nContinuar después"];
final [label="Validar obligatorias y formatos\nCalcular y guardar resultado"];
lect [label="Consultar plantillas, QR\nhistorial y resumen"];
cor [label="¿Corregir un control\nfinalizado?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
rev [label="Crear revisión con motivo\nConservar el control original"];
pdf [label="PDF disponible para\ncontroles finalizados"];
api [label="API valida permiso, versión y reglas\nGuardar cambios e historial"];
fin [label="Continuar trabajando\no cerrar sesión",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
i -> menu;
menu -> op;
op -> l [label="Lotes"];
op -> c [label="Nuevo control"];
op -> lect [label="Consultar"];
l -> api;
c -> f;
f -> b [label="Borrador"];
f -> final [label="Finalizar"];
b -> api;
final -> api;
lect -> cor;
cor -> rev [label="Sí"];
rev -> f;
cor -> pdf [label="No"];
pdf -> fin;
api -> fin [label="Guardado correcto"];
}
