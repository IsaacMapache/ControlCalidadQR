digraph flujo { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#F5EFFC", color="#9873BA", fontcolor="#30203D", fontname="Arial", fontsize=12, margin="0.18,0.12", penwidth=1.2]; edge [color="#79569A", fontcolor="#593080", fontname="Arial", fontsize=10, arrowsize=0.7];
i [label="Nuevo control autorizado",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
sel [label="Elegir lote activo y plantilla activa"];
snap [label="Copiar criterios y versión de plantilla"];
resp [label="Capturar respuestas y observaciones"];
accion [label="¿Guardar borrador\no finalizar?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
bor [label="¿Formatos de respuestas válidos?\nSe permiten obligatorias vacías",shape=diamond,style=filled,fillcolor="#E8D9F6"];
gb [label="Guardar resultado Borrador\nContinuar después",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
completo [label="¿Obligatorias completas, formatos\nválidos y al menos una respuesta?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
corregir [label="Mostrar error\nCorregir respuestas"];
inc [label="¿Algún No cumple o número\nfuera de sus límites?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
rech [label="Resultado Rechazado"];
eval [label="¿Hay respuestas\nevaluables?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
ap [label="Resultado Aprobado"];
reg [label="Resultado Registrado"];
fin [label="Guardar control finalizado\nFecha, responsable, versión e historial",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
i -> sel;
sel -> snap;
snap -> resp;
resp -> accion;
accion -> bor [label="Borrador"];
bor -> gb [label="Formatos válidos"];
bor -> corregir [label="Formato inválido"];
accion -> completo [label="Finalizar"];
completo -> corregir [label="No"];
corregir -> resp;
completo -> inc [label="Sí"];
inc -> rech [label="Sí"];
inc -> eval [label="No"];
eval -> ap [label="Sí"];
eval -> reg [label="No"];
rech -> fin;
ap -> fin;
reg -> fin;
}
