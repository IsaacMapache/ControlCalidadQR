digraph flujo { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#F5EFFC", color="#9873BA", fontcolor="#30203D", fontname="Arial", fontsize=12, margin="0.18,0.12", penwidth=1.2]; edge [color="#79569A", fontcolor="#593080", fontname="Arial", fontsize=10, arrowsize=0.7];
i [label="Elegir operación QR",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
tipo [label="¿Generar o leer?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
lote [label="Consultar lote autenticado"];
crear [label="Codificar Id permanente\nCrear PNG con margen blanco"];
salida [label="Guardar PNG o etiqueta HTML\nCompartir QR o copiar código",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
medio [label="Cámara móvil, imagen\no código pegado"];
perm [label="¿Entrada disponible\ny lectura correcta?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
reint [label="Informar cancelación o error\nElegir otra entrada"];
formato [label="¿Formato y Id válidos?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
mal [label="Mostrar código inválido",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
api [label="Buscar lote mediante API\ncon sesión vigente"];
encontrado [label="¿Existe en este servidor?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
no [label="Informar lote no encontrado",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
si [label="Mostrar datos actuales del lote\nAcceder a controles e historial",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
i -> tipo;
tipo -> lote [label="Generar"];
lote -> crear;
crear -> salida;
tipo -> medio [label="Leer"];
medio -> perm;
perm -> reint [label="No"];
reint -> medio;
perm -> formato [label="Sí"];
formato -> mal [label="No"];
formato -> api [label="Sí"];
api -> encontrado;
encontrado -> no [label="No"];
encontrado -> si [label="Sí"];
}
