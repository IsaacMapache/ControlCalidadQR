digraph flujo { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.55", splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#F5EFFC", color="#9873BA", fontcolor="#30203D", fontname="Arial", fontsize=12, margin="0.18,0.12", penwidth=1.2]; edge [color="#79569A", fontcolor="#593080", fontname="Arial", fontsize=10, arrowsize=0.7];
i [label="Enviar cambios desde la app",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
sesion [label="¿Sesión vigente y\ncuenta activa?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
login [label="HTTP 401\nVolver a iniciar sesión",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
rol [label="¿El rol permite\nesta operación?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
denegar [label="HTTP 403\nAcceso denegado",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
tx [label="Abrir transacción y obtener\nbloqueo SQL de calidad"];
version [label="¿Versión y reglas\ndel registro válidas?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
conflicto [label="Revertir transacción\nHTTP 409 y explicación"];
recargar [label="Reabrir y revisar los datos\nantes de volver a guardar",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
escribir [label="Guardar entidad e historial\nIncrementar versión"];
sql [label="¿SQL confirma\nla transacción?",shape=diamond,style=filled,fillcolor="#E8D9F6"];
fallo [label="Revertir si es posible\nInformar error del servidor",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
ok [label="Responder éxito a la app",shape=oval,fillcolor="#7040AD",fontcolor="white",color="#7040AD"];
i -> sesion;
sesion -> login [label="No"];
sesion -> rol [label="Sí"];
rol -> denegar [label="No"];
rol -> tx [label="Sí"];
tx -> version;
version -> conflicto [label="No"];
conflicto -> recargar;
version -> escribir [label="Sí"];
escribir -> sql;
sql -> fallo [label="No"];
sql -> ok [label="Sí"];
}
